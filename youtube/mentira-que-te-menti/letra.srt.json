  "text": "Mentira que te mentí"
 },
 {
  "start": 96.52,
  "end": 97.84,
  "text": "Cuando te dije te amo"
 },
 {
  "start": 98.88,
  "end": 100.64,
  "text": "Yo te dije la verdad"
 },
 {
  "start": 101.12,
  "end": 103.6,
  "text": "Con toda sinceridad"
 },
 {
  "start": 103.6,
  "end": 106.62,
  "text": "Lo que yo siento lo clamo"
 },
 {
  "start": 107.04,
  "end": 109.08,
  "text": "Cuando tus tiernos oídos"
 },
 {
  "start": 109.48,
  "end": 111.54,
  "text": "Me escuchan esta verdad"
 },
 {
  "start": 111.98,
  "end": 114.42,
