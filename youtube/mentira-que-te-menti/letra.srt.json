 },
 {
  "start": 131.82,
  "end": 133.82,
  "text": "Tienes de nácar la frente"
 },
 {
  "start": 133.86,
  "end": 136.44,
  "text": "Los labios de terciopelo"
 },
 {
  "start": 137.5,
  "end": 139.3,
  "text": "Quiero subirme en tu pelo"
 },
 {
  "start": 139.66,
  "end": 142.0,
  "text": "Yo quiero alcanzar el cielo"
 },
 {
  "start": 142.54,
  "end": 145.44,
