  "text": "Que es una mentira dices"
 },
 {
  "start": 13.86,
  "end": 16.08,
  "text": "Mentira que te mentí"
 },
 {
  "start": 16.46,
  "end": 18.4,
  "text": "Que el corazón me lo dice"
 },
 {
  "start": 18.86,
  "end": 21.46,
  "text": "Y yo te lo digo a ti"
 },
 {
  "start": 21.9,
  "end": 23.98,
  "text": "Las trenzas de tu cabello"
 },
 {
  "start": 24.62,
  "end": 26.58,
  "text": "Se tejen en paralelo"
 },
 {
  "start": 27.06,
  "end": 29.3,
  "text": "Con las trenzas de tu pelo"
 },
 {
  "start": 29.74,
  "end": 32.28,
  "text": "Se puede alcanzar el cielo"
