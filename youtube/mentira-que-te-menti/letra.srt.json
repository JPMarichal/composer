 },
 {
  "start": 51.56,
  "end": 53.74,
  "text": "Tus ojos me miran locos"
 },
 {
  "start": 53.8,
  "end": 56.3,
  "text": "Cuando tuerces la mirada"
 },
 {
  "start": 56.8,
  "end": 58.9,
  "text": "Cuando me miras sesgada"
 },
 {
  "start": 59.26,
  "end": 61.7,
  "text": "Me miras equivocada"
 },
 {
  "start": 62.1,
  "end": 64.46,
  "text": "Con cien aromas surtidos"
